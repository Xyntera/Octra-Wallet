<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block plaintext HTTP everywhere by default. The Octra RPC is HTTPS
         (https://octra.network) and the retired HTTP endpoint is auto-migrated
         to HTTPS at startup. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext only for local development nodes (emulator/localhost),
         so an advanced user running a local Octra node can still connect. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
